generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @db.Text
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
}

model PermissionGroup {
  id          String            @id @default(uuid())
  name        String            @db.Text
  parent      PermissionGroup?  @relation("SelfRelation", fields: [parentId], references: [id])
  subGroups   PermissionGroup[] @relation("SelfRelation")
  parentId    String?
  permissions Permission[]
  createdAt   DateTime          @default(now())
}

model Permission {
  code              String           @id
  name              String           @db.Text
  roles             Role[]
  createdAt         DateTime         @default(now())
  permissionGroup   PermissionGroup? @relation(fields: [permissionGroupId], references: [id])
  permissionGroupId String?
}

model Company {
  id                     String   @id @default(uuid())
  name                   String   @db.Text
  address                String?  @db.Text
  email                  String?
  phone                  String?
  tax                    String?
  website                String?  @db.Text
  logo                   String?  @db.Text
  representativeName     String?  @db.Text
  representativePosition String?  @db.Text
  wardCode               Int?
  ward                   Ward?    @relation(fields: [wardCode], references: [code])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  creatorId              String?
  updaterId              String?
  creator                User?    @relation("creator", fields: [creatorId], references: [id])
  updater                User?    @relation("updater", fields: [updaterId], references: [id])
  users                  User[]
}

model City {
  code         Int        @id @unique
  name         String
  phoneCode    Int?
  divisionType String?
  districts    District[]
}

model District {
  code          Int     @id @unique
  name          String
  codeName      String?
  divisionType  String?
  shortCodeName String?
  cityId        Int
  city          City?   @relation(fields: [cityId], references: [code])
  wards         Ward[]
}

model Ward {
  code          Int       @id @unique
  name          String
  codeName      String?
  divisionType  String?
  shortCodeName String?
  districtId    Int
  district      District? @relation(fields: [districtId], references: [code])
  users         User[]
  companies     Company[]
}

model User {
  id               String          @id @default(uuid())
  name             String          @db.Text
  username         String          @unique
  password         String
  status           UserStatus      @default(ACTIVE)
  email            String?         @unique
  phone            String?         @unique
  avatar           String?         @db.Text
  wardCode         Int?
  ward             Ward?           @relation(fields: [wardCode], references: [code])
  address          String?         @db.Text
  birthDate        DateTime?
  roleId           String?
  role             Role?           @relation(fields: [roleId], references: [id])
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createProjects   Project[]       @relation("creator")
  updateProjects   Project[]       @relation("updater")
  createProducts   Product[]       @relation("creator")
  updateProducts   Product[]       @relation("updater")
  createUnits      Unit[]          @relation("creator")
  updateUnits      Unit[]          @relation("updater")
  createQuotations Quotation[]     @relation("creator")
  updateQuotations Quotation[]     @relation("updater")
  createCompanies  Company[]       @relation("creator")
  updateCompanies  Company[]       @relation("updater")
  createTickets    Ticket[]        @relation("creator")
  updateTickets    Ticket[]        @relation("updater")
  assigneeTickets  Ticket[]        @relation("assigneeTicket")
  createCategories Category[]      @relation("creator")
  updateCategories Category[]      @relation("updater")
  createTrash      Trash[]         @relation("creator")
  ticketComments   TicketComment[]
  userSessions     UserSession[]
}

model Project {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  price        Float
  status       ProjectStatus
  address      String?       @db.Text
  desc         String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  creatorId    String?
  updaterId    String?
  creator      User?         @relation("creator", fields: [creatorId], references: [id])
  updater      User?         @relation("updater", fields: [updaterId], references: [id])
  projectItems ProjectItem[]
  quotations   Quotation[]
}

model ProjectItem {
  id             String   @id @default(uuid())
  projectId      String
  productId      String?
  productCapture Json
  unit           String   @db.Text
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @db.Text
  thumb     String?  @db.Text
  desc      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creatorId String?
  updaterId String?
  creator   User?    @relation("creator", fields: [creatorId], references: [id])
  updater   User?    @relation("updater", fields: [updaterId], references: [id])
}

model Product {
  id                String             @id @default(uuid())
  name              String             @db.Text
  thumb             String?            @db.Text
  desc              String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  creatorId         String?
  updaterId         String?
  creator           User?              @relation("creator", fields: [creatorId], references: [id])
  updater           User?              @relation("updater", fields: [updaterId], references: [id])
  projectItems      ProjectItem[]
  productAttributes ProductAttribute[] @relation("productAttribute")
}

model ProductAttribute {
  key       String
  value     String   @db.Text
  productId String
  product   Product? @relation("productAttribute", fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([key, productId])
}

model Unit {
  id        String   @id @default(uuid())
  name      String   @db.Text
  code      String?
  desc      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creatorId String?
  updaterId String?
  creator   User?    @relation("creator", fields: [creatorId], references: [id])
  updater   User?    @relation("updater", fields: [updaterId], references: [id])

  @@unique([code, creatorId])
}

model Quotation {
  id                 String             @id @default(uuid())
  name               String             @db.Text
  desc               String?            @db.Text
  price              Float
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status             QuotationStatus
  items              QuotationItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  creatorId          String?
  updaterId          String?
  creator            User?              @relation("creator", fields: [creatorId], references: [id])
  updater            User?              @relation("updater", fields: [updaterId], references: [id])
  quotationHistories QuotationHistory[]

  @@unique([creatorId, projectId])
}

model QuotationHistory {
  id               String     @id @default(uuid())
  quotationCapture Json
  createdAt        DateTime   @default(now())
  quotationId      String
  quotation        Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id            String          @id @default(uuid())
  code          String          @unique
  type          TicketType
  status        TicketStatus    @default(OPEN)
  title         String          @db.Text
  createdAt     DateTime        @default(now())
  lastCommentAt DateTime?
  lastComment   String?
  creatorId     String?
  updaterId     String?
  creator       User?           @relation("creator", fields: [creatorId], references: [id])
  updater       User?           @relation("updater", fields: [updaterId], references: [id])
  assignees     User[]          @relation("assigneeTicket")
  comments      TicketComment[]
}

model TicketComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  ticketId  String
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  creatorId String?
  creator   User?    @relation(fields: [creatorId], references: [id])
  createdAt DateTime @default(now())
}

model QuotationItem {
  id                 String            @id @default(uuid())
  quotationId        String
  unit               String            @db.Text
  productQuotationId String?
  productQuotation   ProductQuotation? @relation(fields: [productQuotationId], references: [id], onDelete: Cascade)
  attachedFiles      Media[]
  quantity           Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  quotation          Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model ProductQuotation {
  id                String                      @id @default(uuid())
  name              String                      @db.Text
  thumb             String?                     @db.Text
  desc              String?                     @db.Text
  quotationItems    QuotationItem[]
  productAttributes ProductQuotationAttribute[] @relation("productQuatationAttribute")
}

model ProductQuotationAttribute {
  key                String
  value              String            @db.Text
  productQuotationId String
  productQuotation   ProductQuotation? @relation("productQuatationAttribute", fields: [productQuotationId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@id([key, productQuotationId])
}

model Media {
  id             String          @id @default(uuid())
  name           String
  path           String
  createdAt      DateTime        @default(now())
  quotationItems QuotationItem[]
}

model Trash {
  id         String   @id @default(uuid())
  modelName  String
  data       Json
  deletedAt  DateTime @default(now())
  isRestored Boolean  @default(false)
  creatorId  String?
  creator    User?    @relation("creator", fields: [creatorId], references: [id])
}

model UserSession {
  id           String   @id @default(uuid())
  refreshToken String   @db.Text
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

enum QuotationStatus {
  PENDING
  APPROVED
  CANCELED
  REQUESTED_EDIT
}

enum ProjectStatus {
  PENDING
  APPROVED
  QUOTED
  CANCELED
  COMPLETED
  REQUESTED_EDIT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum TicketType {
  PROJECT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  QUOTATION
}
